{
  "name": "section-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply section-editor --local",
    "db:migrate:remote": "wrangler d1 migrations apply section-editor --remote",
    "deploy": "pnpm install --frozen-lockfile && pnpm audit --audit-level high && vite build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.8",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/ai": "^0.68.0",
    "@tanstack/ai-typesafe": "^0.1.11",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "lucide": "^1.56.0",
    "lucide-react": "^1.56.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
